<?xml version="1.0"?>
<ruleset name="Custom PMD Ruleset for Spring Boot Backend"
    xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.net/ruleset_2_0_0.xsd">

    <description>
        Custom PMD ruleset for Spring Boot backend projects.
        Focuses on common code smells, best practices, and reasonable complexity thresholds.
    </description>

    <!-- Best Practices -->
    <rule ref="category/java/bestpractices.xml">
        <exclude name="UnusedImports"/>
        <exclude name="UnusedPrivateField"/>
        <exclude name="UnusedLocalVariable"/>
        <exclude name="UnusedPrivateMethod"/>
    </rule>

    <!-- Code Style -->
    <rule ref="category/java/codestyle.xml">
        <exclude name="MethodArgumentCouldBeFinal"/>
        <exclude name="LocalVariableCouldBeFinal"/>
        <exclude name="FieldDeclarationsShouldBeAtStartOfClass"/>
    </rule>

    <!-- Design -->
    <rule ref="category/java/design.xml">
        <exclude name="ExcessiveMethodLength"/>
        <exclude name="ExcessiveClassLength"/>
        <exclude name="TooManyFields"/>
        <exclude name="TooManyMethods"/>
        <exclude name="LoosePackageCoupling"/>
    </rule>

    <!-- Error Prone -->
    <rule ref="category/java/errorprone.xml">
        <exclude name="EmptyCatchBlock"/>
        <exclude name="EmptyFinallyBlock"/>
        <exclude name="EmptyIfStmt"/>
        <exclude name="EmptyWhileStmt"/>
        <exclude name="EmptyTryBlock"/>
        <exclude name="EmptySwitchStatements"/>
    </rule>

    <!-- Multithreading -->
    <rule ref="category/java/multithreading.xml/UseConcurrentHashMap"/>

    <!-- Performance -->
    <rule ref="category/java/performance.xml">
        <exclude name="InefficientEmptyStringCheck"/>
        <exclude name="InefficientStringBuffering"/>
        <exclude name="StringInstantiation"/>
    </rule>

    <!-- Security -->
    <rule ref="category/java/security.xml"/>

    <!-- Custom thresholds for complexity -->
    <rule ref="category/java/design.xml/CyclomaticComplexity">
        <properties>
            <property name="classReportLevel" value="10"/>
            <property name="methodReportLevel" value="10"/>
        </properties>
    </rule>

    <rule ref="category/java/design.xml/NcssMethodCount">
        <properties>
            <property name="minimum" value="30"/>
        </properties>
    </rule>

    <rule ref="category/java/design.xml/NcssTypeCount">
        <properties>
            <property name="minimum" value="200"/>
        </properties>
    </rule>

</ruleset>